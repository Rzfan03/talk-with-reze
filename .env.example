# URL publik untuk canonical, sitemap, dan OG image.
# Di Vercel otomatis memakai domain produksi; isi manual untuk domain sendiri.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Wajib di production. Buat dengan: openssl rand -hex 32
SESSION_SECRET=

# Opsional. Host tambahan untuk provider custom di production (pisahkan dengan koma).
# Preset resmi sudah otomatis diizinkan. Contoh: litellm.contoh.com
ALLOWED_PROVIDER_HOSTS=

# Key demo server-side (opsional). Jangan pakai prefix NEXT_PUBLIC_.
# Provider lain: DEMO_ANTHROPIC_API_KEY, DEMO_XAI_API_KEY, DEMO_OPENROUTER_API_KEY, DEMO_OPENAI_API_KEY, DEMO_GOOGLE_API_KEY.
DEMO_GROQ_API_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
